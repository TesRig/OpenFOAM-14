#!/usr/bin/env bash
set -euo pipefail

case_dir="$PWD"
ranks=1
gpu=0

while (($#)); do
    case "$1" in
        --case) case_dir="$2"; shift 2 ;;
        --ranks) ranks="$2"; shift 2 ;;
        --gpu) gpu=1; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
done

(($#)) || {
    echo "usage: openfoam-run [--case DIR] [--ranks N] [--gpu] -- EXECUTABLE [ARGS...]" >&2
    exit 2
}

launcher_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$launcher_dir/OpenFOAM/OpenFOAM-14"
runtime_lib="$launcher_dir/runtime/lib"

# shellcheck disable=SC1091
set +u
source "$project_dir/etc/bashrc" WM_MPLIB=SYSTEMOPENMPI SCOTCH_TYPE=system ParaView_TYPE=none
set -u
export LD_LIBRARY_PATH="$runtime_lib:${LD_LIBRARY_PATH:-}"

if (( gpu && ranks > 1 )); then
    echo "The AmgX plugin currently supports one process/GPU only; use --ranks 1." >&2
    exit 4
fi
if (( gpu )); then
    export FOAM_GPU_BACKEND=amgx
    [[ -f "$FOAM_LIBBIN/libamgxFoam.so" ]] || {
        echo "This package does not contain the AmgX plugin." >&2
        exit 5
    }
fi

cd "$case_dir"
if (( ranks > 1 )); then
    command -v mpirun >/dev/null 2>&1 || {
        echo "Open MPI's mpirun is required for --ranks greater than 1." >&2
        exit 6
    }
    exec mpirun --bind-to core -np "$ranks" "$@" -parallel
else
    exec "$@"
fi

